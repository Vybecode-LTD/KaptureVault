<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         Window
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TextBlock
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TextBox
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource AppBgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Button — base
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource AppBgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="RenderTransform" Value="scaleX(1) scaleY(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scaleX(0.97) scaleY(0.97)"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppBgTertiary}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Button — accent class
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0D1117" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Button — danger class
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#18F85149" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         ListBox & ListBoxItem
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         ComboBox
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource AppBgTertiary}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         ToggleSwitch
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         ScrollViewer / ScrollBar
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="MinHeight" Value="6"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="10"/>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="10"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         ToolTip
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource AppBgTertiary}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Reusable component classes
         ═══════════════════════════════════════════════════════════ -->

    <!-- Vertical separator line -->
    <Style Selector="Border.separator">
        <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="Width" Value="1" />
    </Style>

    <!-- Pill badge -->
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource AppBgTertiary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Card — elevated surface with shadow -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AppBgSecondary}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
    </Style>

    <!-- Card with accent left bar -->
    <Style Selector="Border.card-accent">
        <Setter Property="Background" Value="{DynamicResource AppBgSecondary}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
    </Style>

    <!-- Hoverable card -->
    <Style Selector="Border.card-hover">
        <Setter Property="Background" Value="{DynamicResource AppBgSecondary}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
        <Setter Property="RenderTransform" Value="translateY(0px)"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.card-hover:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowHover}"/>
        <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
    </Style>

    <!-- Section header text -->
    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Monospace text -->
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Detail label (key in key-value rows) -->
    <Style Selector="TextBlock.detail-label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    </Style>

    <!-- Detail value -->
    <Style Selector="TextBlock.detail-value">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Nav button — section switcher tabs
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Button.nav-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="RenderTransform" Value="scaleX(1) scaleY(1)"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nav-btn:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
    </Style>
    <Style Selector="Button.nav-btn:pressed">
        <Setter Property="RenderTransform" Value="scaleX(0.95) scaleY(0.95)"/>
    </Style>
    <Style Selector="Button.nav-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Active nav button — applied via conditional class -->
    <Style Selector="Button.nav-active">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.nav-active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         NumericUpDown
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource AppBgTertiary}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Empty state placeholder text -->
    <Style Selector="TextBlock.empty-state">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>

    <!-- Keyboard hint label (for QuickPaste footer etc.) -->
    <Style Selector="TextBlock.kbd-hint">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Icon text (Segoe MDL2 Assets)
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.icon-lg">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFont}"/>
        <Setter Property="FontSize" Value="42"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Opacity" Value="0.25"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Panel header — elevated surface with shadow below
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Border.panel-header">
        <Setter Property="Background" Value="{DynamicResource AppBgSecondary}"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BoxShadow" Value="{DynamicResource HeaderShadow}"/>
    </Style>

    <!-- Panel footer — elevated from below -->
    <Style Selector="Border.panel-footer">
        <Setter Property="Background" Value="{DynamicResource AppBgSecondary}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BoxShadow" Value="{DynamicResource FooterShadow}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Progress track — inset appearance
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Border.progress-track">
        <Setter Property="Background" Value="{DynamicResource AppBgTertiary}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BoxShadow" Value="{DynamicResource InsetShadow}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Icon button — transparent, for toolbar icons
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.icon-btn:pointerover">
        <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Search overlay
         ═══════════════════════════════════════════════════════════ -->
    <Style Selector="Border.search-overlay">
        <Setter Property="Background" Value="{DynamicResource AppBgSecondary}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentDimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}"/>
    </Style>

</Styles>
