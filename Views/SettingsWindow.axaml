<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kapture.ViewModels"
        x:Class="Kapture.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="KaptureVault Settings"
        Icon="/Assets/app.ico"
        Width="520" Height="750"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        MinWidth="480" MinHeight="500">

    <Grid RowDefinitions="*,Auto" Margin="0">
        <!-- Scrollable settings content -->
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" Padding="20,16,20,0" HorizontalScrollBarVisibility="Disabled">
            <!-- SettingsContent.MaxWidth is set in code-behind to the viewer's visible width
                 (Bounds - Padding) so long wrapping paragraphs wrap instead of overflowing the
                 cards (the ScrollViewer measures its content at unbounded width here). -->
            <StackPanel x:Name="SettingsContent" Spacing="20" Margin="0,0,0,40">

                <!-- Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Theme" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Width="140" SelectedItem="{Binding SelectedTheme}">
                                    <x:String>Dark</x:String>
                                    <x:String>Light</x:String>
                                    <x:String>Sunset</x:String>
                                    <x:String>Dawn</x:String>
                                    <x:String>Oceanic</x:String>
                                    <x:String>Rose</x:String>
                                </ComboBox>
                            </Grid>
                            <Button Content="Apply Theme" Click="ApplyTheme_Click"
                                    HorizontalAlignment="Right" Padding="12,5" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- General (Run on startup binds to the main view model's command; Export DB is
                     handled in code-behind so its file picker parents to this window) -->
                <StackPanel Spacing="8">
                    <TextBlock Text="General" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel x:Name="GeneralPanel" x:DataType="vm:MainWindowViewModel" Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Run on startup"/>
                                    <TextBlock Text="Launch KaptureVault automatically when you sign in to Windows"
                                               FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleStartupCommand}" Content="{Binding StartupButtonText}"
                                        VerticalAlignment="Center" Padding="12,6" FontSize="12"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Export vault database"/>
                                    <TextBlock Text="Save a complete backup copy of the vault (.db) to a file you choose. If encryption is on, the backup is encrypted and needs your password to restore."
                                               FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export DB…" Click="ExportDb_Click"
                                        VerticalAlignment="Center" Padding="12,6" FontSize="12"/>
                            </Grid>
                            <TextBlock x:Name="GeneralStatusText" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Capture Settings -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Capture" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Buffer Size (characters)"/>
                                    <TextBlock Text="Max chars before auto-flush" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1" Width="120" Minimum="500" Maximum="50000" Increment="500"
                                               Value="{Binding MaxBufferChars}" FormatString="N0"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Idle Flush (seconds)"/>
                                    <TextBlock Text="Flush buffer after this idle time" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1" Width="120" Minimum="5" Maximum="300" Increment="5"
                                               Value="{Binding IdleFlushSeconds}" FormatString="N0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Auto-Cleanup -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Auto-Cleanup" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Enable Auto-Cleanup"/>
                                    <TextBlock Text="Automatically delete old entries" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCleanupEnabled}" OnContent="" OffContent=""/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding AutoCleanupEnabled}"/>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AutoCleanupEnabled}">
                                <TextBlock Text="Retention Period (days)" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1" Width="120" Minimum="1" Maximum="365" Increment="1"
                                               Value="{Binding RetentionDays}" FormatString="N0"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding AutoCleanupEnabled}"/>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding AutoCleanupEnabled}">
                                <TextBlock Text="Exclude Pinned Entries" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ExcludePinnedFromCleanup}" OnContent="" OffContent=""/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Quick Paste -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Quick Paste" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Enable Quick Paste"/>
                                    <TextBlock Text="Global hotkey to search and paste entries" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding QuickPasteEnabled}" OnContent="" OffContent=""/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding QuickPasteEnabled}"/>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding QuickPasteEnabled}">
                                <TextBlock Text="Hotkey" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Width="140" Text="{Binding QuickPasteHotkey}" IsReadOnly="True"
                                         Background="{DynamicResource AppBgTertiary}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Encryption -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Encryption" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Text="AES-256-GCM encryption protects all entry content at rest. A password is required to unlock the vault on startup."
                                       FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="EnableEncryptionBtn" Content="Enable Encryption" Click="EnableEncryption_Click" Padding="12,6" FontSize="12"/>
                                <Button x:Name="DisableEncryptionBtn" Content="Disable Encryption" Click="DisableEncryption_Click" Padding="12,6" FontSize="12"/>
                            </StackPanel>
                            <TextBlock x:Name="EncryptionStatusText" FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cloud Sync -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Cloud Sync" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="Enable Cloud Sync"/>
                                    <TextBlock Text="Sync database to cloud storage" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CloudSyncEnabled}" OnContent="" OffContent=""/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding CloudSyncEnabled}"/>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CloudSyncEnabled}">
                                <TextBlock Text="Sync Interval (minutes)" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1" Width="120" Minimum="5" Maximum="120" Increment="5"
                                               Value="{Binding CloudSyncIntervalMinutes}" FormatString="N0"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding CloudSyncEnabled}"/>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CloudSyncEnabled}">
                                <TextBlock Text="Sync on App Close" VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding SyncOnClose}" OnContent="" OffContent=""/>
                            </Grid>
                            <!-- Provider connections -->
                            <Border Height="1" Background="{DynamicResource AppBorderBrush}" IsVisible="{Binding CloudSyncEnabled}"/>
                            <StackPanel Spacing="8" IsVisible="{Binding CloudSyncEnabled}">
                                <TextBlock Text="Cloud Providers" FontSize="12" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="Google Drive" FontSize="12"/>
                                        <TextBlock x:Name="GoogleStatusText" Text="Not connected" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AppTextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="GoogleConnectBtn" Content="Connect" Click="GoogleConnect_Click"
                                                Padding="10,4" FontSize="11"/>
                                        <Button x:Name="GoogleDisconnectBtn" Content="Disconnect" Click="GoogleDisconnect_Click"
                                                Padding="10,4" FontSize="11" IsVisible="False"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource AppBorderBrush}"/>
                                <StackPanel Spacing="6">
                                    <Button x:Name="SyncNowBtn" Content="Sync Now" Click="SyncNow_Click"
                                            Classes="accent" Padding="12,5" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="SyncStatusText" Text="" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Online Vault (paid tier) -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Online Vault" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel x:Name="OnlineVaultPanel" x:DataType="vm:OnlineAccountViewModel" Spacing="12">
                            <TextBlock Text="Sign in to sync your encrypted vault to the cloud and open it from any browser — free. Your data stays end-to-end encrypted; the server only ever holds ciphertext. Upgrade for file hosting and shareable links."
                                       FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>

                            <!-- Shown until the deploy-time backend URL + sign-in client id are configured -->
                            <TextBlock Text="Online Vault isn't available in this build yet."
                                       FontSize="11" FontStyle="Italic" Foreground="{DynamicResource AppTextSecondary}"
                                       IsVisible="{Binding !IsConfigured}"/>

                            <StackPanel Spacing="10" IsVisible="{Binding IsConfigured}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AccountSummary}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SubscriptionStatus, StringFormat='Subscription: {0}'}"
                                                   FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"
                                                   IsVisible="{Binding IsSignedIn}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="Sign in with Google" Command="{Binding SignInCommand}"
                                                IsVisible="{Binding !IsSignedIn}" Padding="10,4" FontSize="11"/>
                                        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                                IsVisible="{Binding IsSignedIn}" Padding="10,4" FontSize="11"/>
                                        <Button Content="Sign out" Command="{Binding SignOutCommand}"
                                                IsVisible="{Binding IsSignedIn}" Padding="10,4" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                                <!-- Open the web vault (shown once signed in; free + paid) -->
                                <Button Content="Open Vault in browser" Command="{Binding OpenVaultCommand}"
                                        IsVisible="{Binding IsSignedIn}" HorizontalAlignment="Left" Padding="12,5" FontSize="11"/>
                                <!-- Upgrade pitch (signed in but not subscribed) -->
                                <StackPanel Spacing="6" IsVisible="{Binding CanSubscribe}">
                                    <TextBlock Text="Upgrade to add encrypted file hosting and publicly shareable links."
                                               FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                                    <Button Content="Upgrade — $49/yr" Command="{Binding SubscribeCommand}"
                                            Classes="accent" HorizontalAlignment="Left" Padding="12,5" FontSize="11"/>
                                </StackPanel>
                                <Button Content="Manage billing" Command="{Binding ManageBillingCommand}"
                                        IsVisible="{Binding CanManageBilling}" HorizontalAlignment="Left" Padding="12,5" FontSize="11"/>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontStyle="Italic"
                                           Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Advanced -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Advanced" FontSize="15" Classes="section-header"/>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Capture Admin App Keystrokes"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"
                                               Text="Run KaptureVault with administrator privileges so keystrokes typed inside elevated apps (Task Manager, Registry Editor, etc.) are captured."/>
                                    <TextBlock FontSize="11" Foreground="#E08030" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="⚠ KaptureVault will restart. A UAC prompt will appear on every Windows login."/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CaptureAdminApps}" OnContent="" OffContent=""/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom action bar -->
        <Border Grid.Row="1" Background="{DynamicResource AppBgSecondary}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Content="Reset Defaults" Command="{Binding ResetDefaultsCommand}"/>
                <Button Grid.Column="2" Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Grid.Column="3" Content="Save" Classes="accent"
                        Command="{Binding SaveSettingsCommand}" Click="Save_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
