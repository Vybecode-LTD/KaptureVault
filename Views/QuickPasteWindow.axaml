<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:Kapture.Models"
        xmlns:local="using:Kapture.Views"
        x:Class="Kapture.Views.QuickPasteWindow"
        Title="Quick Paste"
        Width="600" Height="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource AppBgBrush}" CornerRadius="8"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
            BoxShadow="{DynamicResource DialogShadow}"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0">
            <!-- Search bar -->
            <Border Grid.Row="0" Background="{DynamicResource AppBgSecondary}" Padding="12,10"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="⚡" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Watermark="Type to search entries..."
                             FontSize="15" Padding="10,8"
                             KeyDown="SearchBox_KeyDown"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>

            <!-- Results list -->
            <ListBox x:Name="ResultsList" Grid.Row="1"
                     Background="Transparent"
                     SelectionMode="Single"
                     DoubleTapped="ResultsList_DoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="m:CaptureEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,4">
                            <!-- Type badge -->
                            <Border Grid.Column="0" CornerRadius="3" Padding="4,2" VerticalAlignment="Center"
                                    Margin="0,0,8,0" Opacity="0.3"
                                    Background="{Binding EntryType, Converter={x:Static local:QuickPasteConverters.TypeColorConverter}}">
                                <TextBlock Text="{Binding EntryType, Converter={x:Static local:QuickPasteConverters.TypeIconConverter}}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{Binding EntryType, Converter={x:Static local:QuickPasteConverters.TypeColorConverter}}"/>
                            </Border>
                            <!-- Content preview -->
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Content, Converter={x:Static local:QuickPasteConverters.PreviewConverter}}"
                                           FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding AppName}" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding CapturedAt, StringFormat='{}{0:MMM dd HH:mm}'}"
                                               FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                            <!-- Char count -->
                            <TextBlock Grid.Column="2" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Text="{Binding CharCount, StringFormat='{}{0}c'}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer hint -->
            <Border Grid.Row="2" Background="{DynamicResource AppBgSecondary}" Padding="12,6"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="↵ Enter to paste" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    <TextBlock Text="↑↓ Navigate" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                    <TextBlock Text="Esc to close" FontSize="11" Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
