<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kapture.Views.Dialogs.DeleteConfirmDialog"
        Title="Confirm Delete"
        Width="340" Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border CornerRadius="8" Width="40" Height="40" Background="#1AF85149"
                    BoxShadow="0 0 12 0 #18F85149" VerticalAlignment="Center">
                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource SymbolFont}" FontSize="18"
                           Foreground="{DynamicResource ErrorBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Permanently delete this entry?" FontSize="14"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,6"/>
            <Button Click="Delete_Click" Padding="16,6" Classes="danger">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource SymbolFont}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="Delete"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
