<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kapture.ViewModels"
        x:Class="Kapture.Views.Dialogs.ExpiryDialog"
        x:DataType="vm:ExpiryDialogViewModel"
        Title="Set Expiry"
        Width="300" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="Auto-delete after:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Options}"
                 SelectedItem="{Binding SelectedOption}"
                 Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ExpiryDialogViewModel+ExpiryOption">
                    <TextBlock Text="{Binding Label}" FontSize="13" Padding="8,6"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,6"/>
            <Button Content="Apply" Classes="accent" Click="Apply_Click" Padding="16,6"/>
        </StackPanel>
    </Grid>
</Window>
