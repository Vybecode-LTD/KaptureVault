<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kapture.Views.Dialogs.TextPromptDialog"
        Title="Enter a value"
        Icon="/Assets/app.ico"
        Width="360" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="PromptText" FontSize="13" TextWrapping="Wrap"/>
        <TextBox x:Name="Input"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,6"/>
            <Button Content="OK" Classes="accent" Click="Ok_Click" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>
