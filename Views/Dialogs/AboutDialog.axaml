<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kapture.Views.Dialogs.AboutDialog"
        Title="About KaptureVault"
        Icon="/Assets/app.ico"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="24,24,24,20">

        <!-- Logo + info -->
        <Grid ColumnDefinitions="Auto,20,*" VerticalAlignment="Center">

            <!-- Logo — visually spans all 4 info rows -->
            <Image Grid.Column="0"
                   Source="/Assets/AppIcon.png"
                   Width="125" Height="125"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>

            <!-- 4-row info panel -->
            <StackPanel Grid.Column="2" Spacing="14" VerticalAlignment="Center">

                <!-- Row 1 · App name + version -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="KaptureVault"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AppTextPrimary}"
                               VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="VersionText"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondary}"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>

                <!-- Row 2 · Product website (clickable) -->
                <TextBlock Text="https://kapture.tools"
                           FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           Tapped="WebsiteLink_Tapped"/>

                <!-- Row 3 · Publisher -->
                <TextBlock Text="VybeCode LTD"
                           FontSize="13"
                           Foreground="{DynamicResource AppTextPrimary}"/>

                <!-- Row 4 · Publisher website (clickable) -->
                <TextBlock Text="https://www.vybeco.de"
                           FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           TextDecorations="Underline"
                           Cursor="Hand"
                           Tapped="PublisherLink_Tapped"/>

            </StackPanel>
        </Grid>

        <!-- Close button -->
        <Button Grid.Row="1" Content="Close" Click="Close_Click"
                HorizontalAlignment="Right"
                Padding="20,6" Margin="0,16,0,0"/>

    </Grid>
</Window>
