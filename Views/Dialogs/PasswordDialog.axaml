<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Kapture.Views.Dialogs.PasswordDialog"
        Title="Kapture - Encryption"
        Width="400" Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Name="TitleText" Text="Unlock Vault" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock x:Name="SubtitleText" Text="Enter your encryption password to unlock."
                       FontSize="12" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Password fields -->
        <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
            <TextBox x:Name="PasswordBox" Watermark="Password" PasswordChar="●" FontSize="14" Padding="10,8"/>
            <TextBox x:Name="ConfirmBox" Watermark="Confirm Password" PasswordChar="●" FontSize="14" Padding="10,8"
                     IsVisible="False"/>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource ErrorBrush}"
                       IsVisible="False" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel_Click" Padding="16,8"/>
            <Button x:Name="SubmitButton" Content="Unlock" Classes="accent" Click="Submit_Click" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
