<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kapture.ViewModels"
        xmlns:online="using:Kapture.Services.CloudSync.Online"
        x:Class="Kapture.Views.FilesWindow"
        x:DataType="vm:FileHostingViewModel"
        Title="Your Files"
        Icon="/Assets/app.ico"
        Width="780" Height="580"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource AppBgSecondary}" Padding="12,8"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="🏠 Home" Click="Home_Click" Padding="10,5" FontSize="12"/>
                <Button Content="⬆ Up" Click="Up_Click" IsEnabled="{Binding !AtRoot}" Padding="10,5" FontSize="12"/>
                <Button Content="New Folder" Click="NewFolder_Click" Padding="10,5" FontSize="12"/>
                <Border Width="1" Background="{DynamicResource AppBorderBrush}" Margin="4,2"/>
                <Button Content="Upload Private 🔒" Click="UploadPrivate_Click" Classes="accent" Padding="10,5" FontSize="12"
                        ToolTip.Tip="Encrypted with your vault key — only you can open it. No public link."/>
                <Button Content="Upload Shareable 🔗" Click="UploadShareable_Click" Padding="10,5" FontSize="12"
                        ToolTip.Tip="Stored as-is so you can create a public link anyone can download."/>
                <Button Content="Refresh" Click="Refresh_Click" Padding="10,5" FontSize="12"
                        IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </Border>

        <!-- Breadcrumb -->
        <TextBlock Grid.Row="1" Text="{Binding CurrentFolderDisplay}" Margin="14,8"
                   FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}"/>

        <!-- Folders + files -->
        <ScrollViewer Grid.Row="2" Padding="12,0,12,12">
            <StackPanel Spacing="6">

                <!-- Sub-folders (click to open) -->
                <ItemsControl ItemsSource="{Binding Subfolders}" IsVisible="{Binding HasSubfolders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Click="OpenFolder_Click" Margin="0,0,6,6" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="📁" FontSize="14"/>
                                    <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Files in this folder -->
                <ItemsControl ItemsSource="{Binding Files}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="online:HostedFile">
                            <Border Classes="card" Padding="10,8" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"
                                               Text="{Binding Encrypted, Converter={x:Static vm:FileHostingViewModel.LockIconConverter}}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AppTextSecondary}"
                                                   Text="{Binding Size, Converter={x:Static vm:FileHostingViewModel.SizeConverter}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Download" Click="Download_Click" Padding="8,4" FontSize="11" Margin="4,0,0,0"/>
                                    <Button Grid.Column="3" Content="Copy link" Click="CopyLink_Click" Padding="8,4" FontSize="11" Margin="4,0,0,0"
                                            IsVisible="{Binding !Encrypted}"/>
                                    <Button Grid.Column="4" Content="Delete" Click="Delete_Click" Padding="8,4" FontSize="11" Margin="4,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="This folder is empty." IsVisible="{Binding !HasFiles}"
                           Foreground="{DynamicResource AppTextSecondary}" FontStyle="Italic" Margin="2,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource AppBgSecondary}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppTextSecondary}"/>
        </Border>
    </Grid>
</Window>
